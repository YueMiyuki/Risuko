{
	"name": "risuko",
	"version": "1.3.0",
	"description": "A full-featured download manager",
	"homepage": "https://risuko.app",
	"author": {
		"name": "YueMiyuki",
		"email": "yuemiyuki4737@gmail.com"
	},
	"copyright": "Copyright© YueMiyuki",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/YueMiyuki/Risuko.git"
	},
	"scripts": {
		"dev": "tauri dev",
		"build": "tauri build",
		"dev:renderer": "vite --config vite.renderer.config.ts --mode development --port 9080",
		"pack:renderer": "vite build --config vite.renderer.config.ts --mode production",
		"android:dev": "node scripts/android-env.mjs pnpm exec tauri android dev",
		"android:build": "node scripts/android-env.mjs pnpm exec tauri android build --apk --split-per-abi",
		"android:build:debug": "node scripts/android-env.mjs pnpm exec tauri android build --debug --target aarch64 --apk && pnpm android:sign:debug",
		"android:build:debug:unsigned": "node scripts/android-env.mjs pnpm exec tauri android build --debug --target aarch64 --apk",
		"android:build:signed": "pnpm android:build && pnpm android:sign",
		"android:sign": "node scripts/sign-android-apks.mjs",
		"android:sign:debug": "node scripts/sign-android-apks.mjs --debug",
		"clean:tauri": "node scripts/clean-tauri.mjs",
		"clean:tauri:android": "node scripts/clean-tauri.mjs --android",
		"clean:tauri:full": "node scripts/clean-tauri.mjs --full",
		"fmt": "biome check --write --max-diagnostics none",
		"typecheck": "vue-tsc --noEmit -p tsconfig.json",
		"test": "node --test \"src/**/*.test.ts\" \"scripts/*.test.mjs\"",
		"check:locales": "node scripts/check-locales.mjs",
		"locale": "node scripts/locale-tool.mjs",
		"check:config-keys": "node scripts/check-config-keys.mjs",
		"verify": "pnpm typecheck && pnpm exec biome ci --max-diagnostics none && pnpm check:locales && pnpm check:config-keys && pnpm test && cd src-tauri && cargo fmt --all --check && cargo clippy --workspace --locked --all-targets -- -D warnings && cargo test --workspace --locked",
		"knip": "knip",
		"pre-commit": "pnpm typecheck && node scripts/pre-commit.mjs",
		"prepare": "husky",
		"risuko": "cargo run --manifest-path src-tauri/Cargo.toml -p risuko-cli --",
		"set-version": "node scripts/set-version.mjs"
	},
	"engines": {
		"node": ">=22.18.0"
	},
	"dependencies": {
		"@lucide/vue": "^1.77.0",
		"@tauri-apps/api": "^2.12.5",
		"@tauri-apps/plugin-barcode-scanner": "^2.5.3",
		"@tauri-apps/plugin-clipboard-manager": "^2.5.0",
		"@tauri-apps/plugin-deep-link": "^2.6.3",
		"@tauri-apps/plugin-dialog": "^2.8.4",
		"@tauri-apps/plugin-notification": "^2.8.1",
		"@tauri-apps/plugin-process": "^2.4.0",
		"@tauri-apps/plugin-updater": "^2.14.1",
		"@vueuse/core": "^15.0.0",
		"cnfast": "^0.2.0",
		"motion-v": "^2.13.0",
		"qrcode": "^1.5.4",
		"reka-ui": "^2.11.0",
		"tw-animate-css": "^1.4.0",
		"vue-sonner": "^2.0.9"
	},
	"devDependencies": {
		"@bany/curl-to-json": "^1.2.10",
		"@biomejs/biome": "2.6.8",
		"@tailwindcss/vite": "^4.3.5",
		"@tauri-apps/cli": "^2.12.6",
		"@types/node": "^26.6.6",
		"@types/qrcode": "^1.5.6",
		"@vitejs/plugin-vue": "^6.0.11",
		"axios": "^1.21.1",
		"husky": "9.1.7",
		"i18next": "^27.2.3",
		"knip": "6.47.0",
		"lodash": "^4.18.1",
		"pinia": "^4.1.0",
		"tailwindcss": "^4.3.5",
		"typescript": "6.0.3",
		"vite": "^8.3.8",
		"vue": "^3.5.46",
		"vue-router": "^5.5.1",
		"vue-tsc": "^3.3.14",
		"vue-virtual-scroller": "3.0.5"
	},
	"packageManager": "pnpm@12.21.0"
}
